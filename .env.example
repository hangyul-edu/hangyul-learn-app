# Base URL of the Hangyul backend API.
#
# Leave EMPTY for local development — the Vite dev server proxies "/api" to the
# backend (see vite.config.ts), so there are no CORS issues.
#
# For a production build, set this to the full backend origin, e.g.
#   VITE_API_BASE_URL=https://api.hangyul.app
VITE_API_BASE_URL=

# Only used by the Vite dev proxy (npm run dev). Where the backend runs locally.
VITE_DEV_BACKEND=http://127.0.0.1:8000

# Only used by the Vite dev server. /admin is forwarded here: the admin
# portal's own dev server (the hangyul-admin repository, npm run dev).
VITE_DEV_ADMIN=http://localhost:5174

# ChannelTalk web SDK plugin key. When set, the app boots the ChannelTalk
# messenger at startup and the FAQ "채팅 상담하기" button opens it. Leave EMPTY
# to skip loading the web SDK (e.g. native shell builds that own the mobile SDK,
# or local dev) — support then falls back to the native bridge if present.
VITE_CHANNEL_TALK_PLUGIN_KEY=
