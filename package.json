{
  "name": "hangyul-learn-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hangyul — Korean learning member web app (React + Vite frontend for the Hangyul API).",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:clean": "node scripts/clean-figma-svg.mjs src/assets/brand/*.svg",
    "assets:check": "node scripts/clean-figma-svg.mjs --check src/assets/brand/*.svg"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "hls.js": "^1.7.3",
    "libphonenumber-js": "^1.13.14",
    "livekit-client": "^2.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
